<UserControl x:Class="Vault.App.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">
        <Image Source="{StaticResource AppLogo}" Width="84" Height="84" HorizontalAlignment="Left" Margin="0,0,0,18"/>
        <TextBlock Text="Password Wallet" Style="{StaticResource Heading}"/>
        <TextBlock Text="Seu cofre de senhas, protegido por pendrive e frase secreta. Tudo fica no seu computador, cifrado."
                   Style="{StaticResource Hint}" FontSize="14" Margin="0,0,0,24"/>
        <Button Content="Criar novo cofre" Command="{Binding CreateVaultCommand}"
                Style="{StaticResource PrimaryButton}" Margin="0,4"/>
    </StackPanel>
</UserControl>
