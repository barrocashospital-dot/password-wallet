<UserControl x:Class="Vault.App.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Logo" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.7"/>
                    <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX" From="0.86" To="1" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY" From="0.86" To="1" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="Button1" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.45" Duration="0:0:0.45"/>
                    <DoubleAnimation Storyboard.TargetName="Shift1" Storyboard.TargetProperty="Y" From="18" To="0" BeginTime="0:0:0.45" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="Button2" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.58" Duration="0:0:0.45"/>
                    <DoubleAnimation Storyboard.TargetName="Shift2" Storyboard.TargetProperty="Y" From="18" To="0" BeginTime="0:0:0.58" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="Button3" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.71" Duration="0:0:0.45"/>
                    <DoubleAnimation Storyboard.TargetName="Shift3" Storyboard.TargetProperty="Y" From="18" To="0" BeginTime="0:0:0.71" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="LogoGlowImage" Storyboard.TargetProperty="Opacity"
                                     From="0.3" To="1" Duration="0:0:2.6">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">
        <Grid x:Name="Logo" Width="300" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <Image x:Name="LogoGlowImage" Source="/Vault.App;component/Assets/logo.png"
                   RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.3">
                <Image.CacheMode>
                    <BitmapCache RenderAtScale="1"/>
                </Image.CacheMode>
                <Image.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="40" Color="#3D7BFF" Opacity="0.9"/>
                </Image.Effect>
            </Image>
            <Image Source="/Vault.App;component/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>

        <Button x:Name="Button1" Content="Criar novo cofre" Command="{Binding CreateVaultCommand}"
                Style="{StaticResource PrimaryButton}" Margin="0,18,0,4" Opacity="0">
            <Button.RenderTransform>
                <TranslateTransform x:Name="Shift1" Y="18"/>
            </Button.RenderTransform>
        </Button>
        <Button x:Name="Button2" Content="Abrir cofre" Command="{Binding OpenVaultCommand}" Margin="0,4" Opacity="0">
            <Button.RenderTransform>
                <TranslateTransform x:Name="Shift2" Y="18"/>
            </Button.RenderTransform>
        </Button>
        <Button x:Name="Button3" Content="Recuperar cofre" Command="{Binding RecoverVaultCommand}" Margin="0,4" Opacity="0">
            <Button.RenderTransform>
                <TranslateTransform x:Name="Shift3" Y="18"/>
            </Button.RenderTransform>
        </Button>
    </StackPanel>
</UserControl>
