<UserControl x:Class="Vault.App.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">
        <Image Source="/Vault.App;component/Assets/logo.png" Width="300" HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Button Content="Criar novo cofre" Command="{Binding CreateVaultCommand}"
                Style="{StaticResource PrimaryButton}" Margin="0,18,0,4"/>
        <Button Content="Abrir cofre" Command="{Binding OpenVaultCommand}" Margin="0,4"/>
    </StackPanel>
</UserControl>
