<UserControl x:Class="Vault.App.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
        <TextBlock Text="Password Wallet" Style="{StaticResource Heading}"/>
        <TextBlock Text="Seu cofre de senhas, protegido por pendrive e frase secreta."
                   TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,24"/>
        <Button Content="Criar novo cofre" Command="{Binding CreateVaultCommand}" Margin="0,4"/>
    </StackPanel>
</UserControl>
