<UserControl x:Class="Vault.App.Views.ShowRecoveryKeyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
            <TextBlock Text="Chave de recuperação" Style="{StaticResource Heading}"/>
            <TextBlock Text="Escreva as 24 palavras no papel, na ordem, e guarde em lugar seguro. Elas não serão mostradas de novo."
                       Style="{StaticResource Hint}" FontSize="14"/>
            <TextBlock Text="{Binding Notice}" Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}"/>
            <Border Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,14">
                <ItemsControl ItemsSource="{Binding NumberedWords}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="16" Margin="0,4,12,4"
                                       Foreground="{StaticResource WarningTextBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Button Content="{Binding CopyLabel}" Command="{Binding CopyCommand}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
            <TextBlock Text="Digite as 24 palavras para confirmar (bastam as 4 primeiras letras de cada)" Style="{StaticResource Field}"/>
            <TextBox Text="{Binding TypedBack, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" VerticalContentAlignment="Top"/>
            <TextBlock Text="{Binding TypedBackHint}" Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <Button Content="Já guardei, continuar" Command="{Binding ContinueCommand}" HorizontalAlignment="Left"
                    Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
