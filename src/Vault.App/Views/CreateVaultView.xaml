<UserControl x:Class="Vault.App.Views.CreateVaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vault.App.Views">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" MaxWidth="560" Margin="0,10,17,0">
            <local:BusyBar Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Voltar" Command="{Binding BackCommand}"/>
                <Button Content="Criar cofre" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560">
                <TextBlock Text="Criar novo cofre" Style="{StaticResource Heading}"/>

                <TextBlock Text="Frase secreta" Style="{StaticResource Field}"/>
                <PasswordBox local:PasswordBoxHelper.BoundPassword="{Binding Passphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding PassphraseHint}" Style="{StaticResource Hint}"/>

                <TextBlock Text="Confirmar frase" Style="{StaticResource Field}"/>
                <PasswordBox local:PasswordBoxHelper.BoundPassword="{Binding Confirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Arquivo-chave" Style="{StaticResource Field}"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Label"
                              MinWidth="320" Margin="0,2,8,2"/>
                    <Button Content="Atualizar" Command="{Binding RefreshDrivesCommand}"/>
                    <Button Content="Outro local…" Command="{Binding BrowseKeyfileCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding DriveWarning}" Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding KeyfilePath}" Style="{StaticResource Hint}"/>

                <TextBlock Text="Arquivo do cofre" Style="{StaticResource Field}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Escolher…" Command="{Binding BrowseVaultCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding VaultPath}" Style="{StaticResource Hint}"/>

                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
