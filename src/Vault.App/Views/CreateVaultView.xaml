<UserControl x:Class="Vault.App.Views.CreateVaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vault.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Center">
            <TextBlock Text="Criar novo cofre" Style="{StaticResource Heading}"/>

            <TextBlock Text="Frase secreta" Style="{StaticResource Field}"/>
            <PasswordBox local:PasswordBoxHelper.BoundPassword="{Binding Passphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding PassphraseHint}" Foreground="Gray"/>

            <TextBlock Text="Confirme a frase" Style="{StaticResource Field}"/>
            <PasswordBox local:PasswordBoxHelper.BoundPassword="{Binding Confirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Pendrive (onde ficará o arquivo-chave)" Style="{StaticResource Field}"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                          MinWidth="160" Margin="0,2,8,2"/>
                <Button Content="Atualizar" Command="{Binding RefreshDrivesCommand}"/>
                <Button Content="Outro local…" Command="{Binding BrowseKeyfileCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding KeyfilePath}" Foreground="Gray" TextWrapping="Wrap"/>

            <TextBlock Text="Arquivo do cofre" Style="{StaticResource Field}"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Escolher…" Command="{Binding BrowseVaultCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding VaultPath}" Foreground="Gray" TextWrapping="Wrap"/>

            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Voltar" Command="{Binding BackCommand}"/>
                <Button Content="Criar cofre" Command="{Binding CreateCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
