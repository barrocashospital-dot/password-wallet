<UserControl x:Class="Vault.App.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vault.App.Views"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LockCommand}"/>
    </UserControl.InputBindings>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Salvar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Bloquear" Command="{Binding LockCommand}"/>
            <TextBlock Text="● não salvo" Foreground="{StaticResource OrangeBrush}" VerticalAlignment="Center"
                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,16,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                    <Button Content="Adicionar" Command="{Binding AddCommand}" MinWidth="70"/>
                    <Button Content="Excluir" Command="{Binding DeleteCommand}" MinWidth="70"/>
                </StackPanel>
                <TextBox DockPanel.Dock="Top" Margin="0,0,0,8" ToolTip="Buscar por título, usuário ou site"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <ListBox ItemsSource="{Binding EntriesView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         DisplayMemberPath="Title"/>
            </DockPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Título" Style="{StaticResource Field}"/>
                    <TextBox Text="{Binding Selected.Title, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Site" Style="{StaticResource Field}"/>
                    <TextBox Text="{Binding Selected.Url, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Usuário" Style="{StaticResource Field}"/>
                    <TextBox Text="{Binding Selected.Username, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Copiar usuário" Command="{Binding CopyUsernameCommand}" HorizontalAlignment="Left"/>

                    <TextBlock Text="Senha" Style="{StaticResource Field}"/>
                    <Grid>
                        <PasswordBox Visibility="{Binding HidePassword, Converter={StaticResource BoolToVis}}"
                                     local:PasswordBoxHelper.BoundPassword="{Binding Selected.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding Selected.Password, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Mostrar" IsChecked="{Binding ShowPassword}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Copiar senha" Command="{Binding CopyPasswordCommand}"/>
                        <Button Content="Gerar" Command="{Binding GeneratePasswordCommand}"/>
                    </StackPanel>

                    <TextBlock Text="Notas" Style="{StaticResource Field}"/>
                    <TextBox Text="{Binding Selected.Notes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
