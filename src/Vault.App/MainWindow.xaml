<Window x:Class="Vault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Wallet" Height="660" Width="940" MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Icon="{StaticResource AppLogo}"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource InkBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource NavyBrush}" Padding="22,12">
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource AppLogo}" Width="30" Height="30"/>
                <TextBlock Text="Password Wallet" Foreground="White" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock Text="cofre local · pendrive + frase" Foreground="#8FA0C8" FontSize="12"
                           VerticalAlignment="Center" Margin="14,3,0,0"/>
            </StackPanel>
        </Border>

        <Border Margin="20" Padding="26" Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </Border>
    </DockPanel>
</Window>
