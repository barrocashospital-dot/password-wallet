<Window x:Class="Vault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Vault.App.Views"
        Title="Password Wallet" Height="660" Width="940" MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Icon="{StaticResource AppLogo}"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource InkBrush}"
        Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <views:CodeRain/>

        <Border Margin="24" Padding="28" Background="{StaticResource CardBrush}" CornerRadius="16"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
            <views:TransitionHost Content="{Binding CurrentViewModel}"/>
        </Border>
    </Grid>
</Window>
